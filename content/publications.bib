@unpublished{jin2026environmentduels,
  selected = {true},
  title = {Environment Duels: A Microcosm of LLM Co-Evolution},
  author = {Shibo Jin* and Zhiqiu Xu* and Yiling Zou and Shangyu Gong and Mayur Naik},
  year = {2026},
  journal = {Manuscript under review},
  abstract = {Environment Duels evaluates language models as both creators and solvers of interactive environments. Each model designs tasks with privileged hints and attempts tasks written by other models. Across nine frontier models, authoring and solving emerge as distinct capabilities; the interactions provide a controlled view of how models challenge and learn from one another.},
  keywords = {LLM agents, interactive environments, multi-agent evaluation, co-evolution},
  preview = {environment-duels-teaser.png},
  preview_width = {1230},
  preview_height = {430}
}

@inproceedings{xu2026mathduels,
  selected = {true},
  title = {MathDuels: A Self-Play Benchmark That Grows},
  author = {Zhiqiu Xu* and Shibo Jin* and Shreya Arya and Mayur Naik},
  year = {2026},
  booktitle = {Conference on Language Modeling (CoLM)},
  abstract = {MathDuels is a self-play benchmark in which language models both author and solve mathematical problems. A generation and validation pipeline produces well-posed challenges, and a Rasch model estimates solver ability and problem difficulty. Experiments across 19 frontier models show that authoring and solving are partially distinct skills and that benchmark difficulty grows with participating models.},
  keywords = {self-play, mathematical reasoning, LLM evaluation},
  preview = {mathduels-leaderboard.png},
  preview_width = {1866},
  preview_height = {1042},
  url = {https://arxiv.org/abs/2604.21916},
  leaderboard = {https://mathduels.ai/},
  blog = {https://www.rabdos.ai/research/introducing-mathduels-ai},
  pdf = {/papers/mathduels.pdf}
}

